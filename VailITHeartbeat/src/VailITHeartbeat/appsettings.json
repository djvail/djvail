{
  "Heartbeat": {
    // How often the long-running service checks (ignored by the 'once' command).
    "IntervalSeconds": 60,

    // Remembers who is down between runs, so 'once' (cron / Task Scheduler) does not
    // email you on every run. A relative path is relative to the .exe folder.
    "StateFile": "heartbeat-state.json",

    // Optional "who watches the watcher" ping: a GET to this URL after every check round,
    // e.g. a free healthchecks.io or Better Stack heartbeat URL. Leave empty to turn off.
    "SelfPingUrl": "",

    "Targets": [
      {
        "Name": "VailIT Dashboard",
        // The dashboard's anonymous health endpoint (200 {"status":"ok",...} when healthy, 503 when not).
        "Url": "https://dashboard.example.com/api/v1/health",
        "TimeoutSeconds": 10,
        "ExpectedStatusCodes": [ 200 ],
        // The JSON body must have this property with this value. Empty property = do not check.
        "ExpectedJsonProperty": "status",
        "ExpectedJsonValue": "ok",
        // Or/also: plain text the body must contain. Empty = do not check.
        "ExpectedBodyContains": "",
        // Consecutive failed checks before the first email (avoids alerts for a single blip).
        "FailuresBeforeAlert": 3,
        // While still down, email again every N minutes. 0 = only the first email.
        "ReminderMinutes": 60,
        // Treat an HTTPS certificate that expires within N days as a failure. 0 = off.
        "CertificateExpiryWarningDays": 14
      }
    ]
  },

  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    // "StartTls" (port 587), "SslOnConnect" (port 465) or "None" (internal relay, port 25).
    "Security": "StartTls",
    "Username": "",
    // Better kept out of this file: set the environment variable Email__Password instead.
    "Password": "",
    "From": "heartbeat@example.com",
    "To": [ "you@example.com" ],
    "SubjectPrefix": "[VailIT Heartbeat]"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
