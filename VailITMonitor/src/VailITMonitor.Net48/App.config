<?xml version="1.0" encoding="utf-8"?>
<!--
  VailITMonitor settings (.NET Framework 4.8 edition).
  After building, this file is copied next to the program as VailITMonitor.exe.config - edit THAT
  copy on the server, then restart the service:   Restart-Service VailITMonitor
  Full reference: docs/03-Configuration.md  (same settings as the .NET 10 appsettings.json)

  .NET Framework configuration is flat key/value pairs, so nested settings use dotted names.
  0 for any KeepDays means "keep forever".
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!-- Smaller memory footprint: no background (concurrent) garbage collection thread. -->
    <gcConcurrent enabled="false" />
    <gcServer enabled="false" />
  </runtime>

  <!--
    file="reporting.config": the dashboard settings written by "VailITMonitor.exe connect" live in that
    separate file next to the program, and override any Reporting.* keys below. A missing file is ignored.
  -->
  <appSettings file="reporting.config">
    <!-- How often a reading is taken. 60 = one reading per minute. -->
    <add key="SampleIntervalSeconds" value="60" />
    <!-- Database, reports and logs. Environment variables are expanded. -->
    <add key="DataFolder" value="%ProgramData%\VailITMonitor-Net48" />
    <add key="MaintenanceIntervalMinutes" value="15" />
    <add key="FirstDayOfWeek" value="Monday" />

    <!-- Which readings to take. -->
    <add key="Metrics.Cpu" value="true" />
    <add key="Metrics.CpuPerCore" value="true" />
    <add key="Metrics.Memory" value="true" />
    <add key="Metrics.Disks" value="true" />
    <add key="Metrics.DiskIo" value="true" />
    <add key="Metrics.Network" value="true" />
    <add key="Metrics.System" value="true" />
    <add key="Metrics.Self" value="true" />
    <!-- Comma separated, e.g. "C:,D:". Empty = every fixed drive. -->
    <add key="Metrics.Drives" value="" />
    <!-- Adapters whose name/description contains any of these (comma separated) are ignored. -->
    <add key="Metrics.ExcludeAdapters" value="Loopback,isatap,Teredo,Bluetooth" />

    <!-- How long each tier is kept, and how often its cleanup runs. -->
    <add key="Retention.Raw.KeepDays" value="30" />
    <add key="Retention.Raw.CleanupEveryDays" value="1" />
    <add key="Retention.Daily.KeepDays" value="730" />
    <add key="Retention.Daily.CleanupEveryDays" value="7" />
    <add key="Retention.Weekly.KeepDays" value="1095" />
    <add key="Retention.Weekly.CleanupEveryDays" value="30" />
    <add key="Retention.Monthly.KeepDays" value="1825" />
    <add key="Retention.Monthly.CleanupEveryDays" value="90" />
    <add key="Retention.Quarterly.KeepDays" value="0" />
    <add key="Retention.Quarterly.CleanupEveryDays" value="365" />
    <add key="Retention.Yearly.KeepDays" value="0" />
    <add key="Retention.Yearly.CleanupEveryDays" value="365" />

    <!-- PDF reports. -->
    <add key="Reports.Enabled" value="true" />
    <add key="Reports.Folder" value="" />
    <add key="Reports.CompanyName" value="Vail IT" />
    <add key="Reports.PageSize" value="Letter" />
    <add key="Reports.DelayMinutes" value="5" />
    <add key="Reports.CatchUpPeriods" value="3" />
    <add key="Reports.Daily.Enabled" value="true" />
    <add key="Reports.Daily.KeepDays" value="90" />
    <add key="Reports.Weekly.Enabled" value="true" />
    <add key="Reports.Weekly.KeepDays" value="365" />
    <add key="Reports.Monthly.Enabled" value="true" />
    <add key="Reports.Monthly.KeepDays" value="0" />
    <add key="Reports.Quarterly.Enabled" value="true" />
    <add key="Reports.Quarterly.KeepDays" value="0" />
    <add key="Reports.Yearly.Enabled" value="true" />
    <add key="Reports.Yearly.KeepDays" value="0" />

    <!-- Reporting to VailITDashboard (docs/06-Dashboard-Reporting.md). Usually set with:
           VailITMonitor.exe connect https://dashboard:5443 vmk_yourkey SQL -->
    <add key="Reporting.Enabled" value="false" />
    <add key="Reporting.DashboardUrl" value="" />
    <add key="Reporting.ApiKeyProtected" value="" />
    <!-- Empty = generated once and kept in <DataFolder>\machine-id.txt -->
    <add key="Reporting.MachineId" value="" />
    <add key="Reporting.ServerType" value="" />
    <add key="Reporting.Tags" value="" />
    <add key="Reporting.IntervalSeconds" value="60" />
    <add key="Reporting.TimeoutSeconds" value="15" />
    <add key="Reporting.PinnedCertificateThumbprint" value="" />
    <add key="Reporting.InitialBacklogMinutes" value="60" />

    <!-- Write informational messages (not just warnings/errors) to the Windows Event Log. -->
    <add key="Logging.Verbose" value="true" />
  </appSettings>
</configuration>
