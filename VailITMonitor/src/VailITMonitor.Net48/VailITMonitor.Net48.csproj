<!--
  VailITMonitor - .NET Framework 4.8 edition.

  This uses the modern "SDK-style" project format, which works fine for .NET Framework and builds
  with Visual Studio 2019+, "dotnet build" or MSBuild. (The old verbose format with a
  <Compile Include="..."> line per file and a packages.config is described in
  docs/05-Framework-vs-Modern-NET.md.)

  The C# language version is pinned to 7.3 - the default for .NET Framework - so the code shows
  how things are written "the Framework way". You may raise it (e.g. <LangVersion>latest</LangVersion>);
  many, but not all, newer C# features work on .NET Framework.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>VailITMonitor</AssemblyName>
    <RootNamespace>VailITMonitor</RootNamespace>
    <Version>1.0.0</Version>
    <Product>VailITMonitor</Product>
    <LangVersion>7.3</LangVersion>

    <!-- 64-bit only: the PDF/chart engines ship 64-bit native DLLs. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Parts of the .NET Framework itself (in the GAC) - referenced, not downloaded. -->
    <Reference Include="System.Configuration" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
    <PackageReference Include="ScottPlot" Version="5.1.59" />
    <!-- ScottPlot pulls in Linux/macOS chart-engine binaries; this Windows service never needs them. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.0" ExcludeAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" ExcludeAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.1" ExcludeAssets="all" />
    <!-- Lets this project build on machines without the 4.8 Developer Pack (and on Linux/macOS). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Remove native DLLs for CPU types other than 64-bit Intel/AMD (x64) from the output. -->
  <Target Name="RemoveUnusedNativeFolders" AfterTargets="Build;Publish">
    <RemoveDir Directories="$(OutDir)arm;$(OutDir)arm64;$(OutDir)x86;$(OutDir)runtimes\win-arm64;$(OutDir)runtimes\win-x86" />
  </Target>

</Project>
