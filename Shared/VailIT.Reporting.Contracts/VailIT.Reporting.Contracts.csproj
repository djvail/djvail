<!--
  The shapes that VailITMonitor sends and VailITDashboard receives.
  netstandard2.0 + C# 7.3 so the .NET Framework 4.8 edition, the .NET 10 edition and the
  dashboard can all reference the same file. Keep it plain: classes with properties only.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>VailIT.Reporting.Contracts</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
