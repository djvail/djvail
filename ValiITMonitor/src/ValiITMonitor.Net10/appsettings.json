{
  // ValiITMonitor settings (.NET 10 edition).
  // Comments are allowed in this file. Restart the service after changing anything:
  //   Restart-Service ValiITMonitor
  // Full reference: docs/03-Configuration.md

  "Monitor": {
    // How often a reading is taken. 60 = one reading per minute.
    "SampleIntervalSeconds": 60,

    // Where the database, reports and logs live. Environment variables are expanded.
    "DataFolder": "%ProgramData%\\ValiITMonitor",

    // How often the background housekeeping (rollups, reports, cleanup) checks for work.
    "MaintenanceIntervalMinutes": 15,

    // First day of the week used for weekly rollups and reports.
    "FirstDayOfWeek": "Monday",

    // Which readings to take. Turn off anything you do not need.
    "Metrics": {
      "Cpu": true,             // total CPU %
      "CpuPerCore": true,      // CPU % for each logical processor
      "Memory": true,          // RAM used/available, commit charge, file cache
      "Disks": true,           // free/used space for each fixed drive
      "DiskIo": true,          // disk read/write KB/s, busy %, queue length (performance counters)
      "Network": true,         // KB/s received/sent per adapter and in total
      "System": true,          // processes, threads, handles, CPU queue, uptime
      "Self": true,            // this service's own RAM and CPU (to prove it is light!)
      "Drives": [],            // e.g. [ "C:", "D:" ]  - empty = every fixed drive
      "ExcludeAdapters": [ "Loopback", "isatap", "Teredo", "Bluetooth" ] // name contains (case-insensitive)
    },

    // How long each tier of data is kept, and how often its cleanup runs.
    // KeepDays = 0 means keep forever.
    "Retention": {
      "Raw":       { "KeepDays": 30,   "CleanupEveryDays": 1 },
      "Daily":     { "KeepDays": 730,  "CleanupEveryDays": 7 },
      "Weekly":    { "KeepDays": 1095, "CleanupEveryDays": 30 },
      "Monthly":   { "KeepDays": 1825, "CleanupEveryDays": 90 },
      "Quarterly": { "KeepDays": 0,    "CleanupEveryDays": 365 },
      "Yearly":    { "KeepDays": 0,    "CleanupEveryDays": 365 }
    },

    "Reports": {
      "Enabled": true,
      "Folder": "",                    // empty = <DataFolder>\Reports
      "CompanyName": "Vali IT",
      "PageSize": "Letter",            // Letter or A4
      "DelayMinutes": 5,               // wait this long after a period ends before reporting on it
      "CatchUpPeriods": 3,             // after downtime, create missed reports for up to this many past periods
      "Daily":     { "Enabled": true, "KeepDays": 90 },
      "Weekly":    { "Enabled": true, "KeepDays": 365 },
      "Monthly":   { "Enabled": true, "KeepDays": 0 },
      "Quarterly": { "Enabled": true, "KeepDays": 0 },
      "Yearly":    { "Enabled": true, "KeepDays": 0 }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "ValiITMonitor": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "ValiITMonitor": "Information"
      }
    }
  }
}
