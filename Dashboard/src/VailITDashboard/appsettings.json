{
  // VailITDashboard settings. Comments are allowed in this file.
  // Restart the service after changing anything:   Restart-Service VailITDashboard
  // Full guide: Dashboard/README.md

  // Where the dashboard listens. Put it behind IIS/a reverse proxy with HTTPS, or use an https:// URL
  // with a certificate (see the README). Monitors must reach this address.
  "Urls": "http://*:5080",

  "Dashboard": {
    // Database location. Environment variables are expanded.
    "DataFolder": "%ProgramData%\\VailITDashboard",

    // The address people (and alert-email links) use to reach the dashboard.
    "PublicUrl": "http://localhost:5080",

    // How often monitors should report, and when a quiet one counts as late / offline.
    "ReportIntervalSeconds": 60,
    "StaleAfterMissedReports": 3,     // amber "late" after 3 missed reports
    "OfflineAfterMissedReports": 5,   // red "offline" + email after 5

    "KeepReadingsDays": 14,           // detailed readings for the charts
    "KeepAlertsDays": 365,            // closed alerts (0 = forever)
    "DefaultGroup": "Unassigned",     // group for a new machine whose monitor sends no serverType
    "MaxReportsPerMinutePerKey": 10,
    "SeedDemoData": false,            // true = fill an EMPTY database with demo servers

    // Who may open the web pages: Password, Windows (Active Directory) or None.
    "Auth": {
      "Mode": "Password",
      // Make a hash with:  VailITDashboard.exe hash-password
      "Users": [
        // { "UserName": "admin", "PasswordHash": "pbkdf2$210000$..." }
      ],
      "AllowedWindowsUsersOrGroups": [],   // Mode Windows only, e.g. [ "CONTOSO\\IT Admins" ]
      "SessionHours": 12
    },

    "Alerts": {
      "EmailEnabled": true,
      "To": [ ],                                  // e.g. [ "dj@example.com", "oncall@example.com" ]
      "From": "VailIT Dashboard <dashboard@example.com>",
      "SubjectPrefix": "[VailIT]",
      "ConsecutiveReports": 3,      // a problem must be seen this many reports in a row (stops one spike alerting)
      "RemindEveryMinutes": 240,    // re-send while still broken; 0 = never
      "SendRecovery": true,         // email when it clears
      "MinimumEmailLevel": "Warning",   // Warning or Critical
      "Smtp": {
        "Host": "",                 // empty = don't send, write emails to the log instead
        "Port": 587,
        "Security": "StartTls",     // StartTls (587), SslOnConnect (465) or None (internal relay on 25)
        "UserName": "",
        "Password": ""
      }
    },

    // Copied into the database as GLOBAL thresholds the first time the dashboard starts.
    // After that, change thresholds on the Thresholds page (per group or per machine too).
    // Instance "*" = every drive / adapter. Direction Below = alert when the value is low.
    "DefaultThresholds": [
      { "Metric": "cpu.total_pct",   "Instance": "*", "Direction": "Above", "Warning": 85, "Critical": 95 },
      { "Metric": "mem.used_pct",    "Instance": "*", "Direction": "Above", "Warning": 85, "Critical": 95 },
      { "Metric": "mem.commit_pct",  "Instance": "*", "Direction": "Above", "Warning": 90, "Critical": 97 },
      { "Metric": "disk.free_pct",   "Instance": "*", "Direction": "Below", "Warning": 15, "Critical": 5 },
      { "Metric": "diskio.busy_pct", "Instance": "*", "Direction": "Above", "Warning": 90 }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "VailITDashboard": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "VailITDashboard": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
